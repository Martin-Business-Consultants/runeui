#!/usr/bin/env node
// Vendors UI SDK's web components (@ui-sdk/web, @ui-sdk/core, Apache-2.0) into the gem as plain
// ES modules that importmap can serve: no build step in the apps that use runeui.
//
// Maintainers run this when moving to a new UI SDK release:
//
//   script/vendor-ui-sdk            # the version in UI_SDK_VERSION below
//   script/vendor-ui-sdk 0.2.0      # another one
//
// It bundles one module per component entry (esbuild, code splitting, minified, the production
// conditions so `#dev` resolves to its stub), then rewrites each relative import to a bare
// specifier (`runeui/sdk/chunk-ABC`) and writes the pins (config/sdk_pins.rb). Bare specifiers
// matter: Propshaft digests file names, so a relative `./chunk-ABC.js` would miss in production.
// It also writes app/javascript/runeui/sdk/entries.js, the list the autoloader matches tags to.

const { execSync } = require("node:child_process")
const fs = require("node:fs")
const os = require("node:os")
const path = require("node:path")

const UI_SDK_VERSION = process.argv[2] || "0.1.0-beta.1"
const root = path.resolve(__dirname, "..")
const out = path.join(root, "app/javascript/runeui/sdk")
const work = fs.mkdtempSync(path.join(os.tmpdir(), "runeui-vendor-"))

const sh = (cmd, cwd = work) => execSync(cmd, { cwd, stdio: ["ignore", "pipe", "inherit"] }).toString()

console.log(`UI SDK ${UI_SDK_VERSION} → ${path.relative(root, out)}`)
sh("npm init -y")
sh(`npm install --no-audit --no-fund @ui-sdk/web@${UI_SDK_VERSION} @ui-sdk/core@${UI_SDK_VERSION} esbuild@0.25`)

const web = path.join(work, "node_modules/@ui-sdk/web")
const pkg = JSON.parse(fs.readFileSync(path.join(web, "package.json")))

// Every subpath export is an entry: "./select" → select. "." is the index (createParts and the
// rest of the authoring API), kept as "index".
const entries = {}
for (const [key, value] of Object.entries(pkg.exports)) {
  if (key.includes("*") || key.endsWith(".json") || key.endsWith(".css")) continue
  const file = typeof value === "string" ? value : value.default || value.import
  if (!file || !file.endsWith(".js")) continue
  entries[key === "." ? "index" : key.slice(2).replaceAll("/", "-")] = path.join(web, file)
}

// Core APIs the Hotwire layer calls without loading every component: toast() and createToaster(),
// the overlay host. Kept as core-<name> so they never collide with a component entry.
const core = path.join(work, "node_modules/@ui-sdk/core")
const corePkg = JSON.parse(fs.readFileSync(path.join(core, "package.json")))
for (const name of ["toast", "overlays"]) {
  const value = corePkg.exports[`./${name}`]
  entries[`core-${name}`] = path.join(core, typeof value === "string" ? value : value.default || value.import)
}

fs.rmSync(out, { recursive: true, force: true })
fs.mkdirSync(out, { recursive: true })

const esbuild = require(path.join(work, "node_modules/esbuild"))
esbuild.buildSync({
  entryPoints: entries,
  bundle: true,
  splitting: true,
  format: "esm",
  minify: true,
  target: "es2022",
  conditions: ["production", "browser", "import", "default"],
  define: { "process.env.NODE_ENV": '"production"' },
  outdir: out,
  chunkNames: "chunk-[hash]",
  legalComments: "eof",
  logLevel: "warning"
})

// ./chunk-X.js → runeui/sdk/chunk-X, in static and dynamic imports alike.
const pins = []
for (const file of fs.readdirSync(out).sort()) {
  if (!file.endsWith(".js")) continue
  const full = path.join(out, file)
  const source = fs.readFileSync(full, "utf8").replace(/(["'])\.\/([\w.-]+)\.js\1/g, (_m, q, name) => `${q}runeui/sdk/${name}${q}`)
  fs.writeFileSync(full, source)
  pins.push(file.replace(/\.js$/, ""))
}

const names = Object.keys(entries).filter((name) => !["index", "agent", "autoload", "events", "history", "observe"].includes(name) && !name.startsWith("core-")).sort()
fs.writeFileSync(path.join(out, "entries.js"),
  `// Generated by script/vendor-ui-sdk from @ui-sdk/web ${UI_SDK_VERSION}. The component entries the autoloader\n` +
  `// matches custom element tags to (ui-select-trigger → select).\nexport const VERSION = ${JSON.stringify(UI_SDK_VERSION)}\nexport const ENTRIES = ${JSON.stringify(names)}\n`)
pins.push("entries")

fs.writeFileSync(path.join(root, "config/sdk_pins.rb"),
  `# Generated by script/vendor-ui-sdk from @ui-sdk/web ${UI_SDK_VERSION}: one pin per vendored module.\n` +
  `# Preloading is off: the autoloader imports a component the first time its tag appears.\n` +
  pins.map((name) => `pin "runeui/sdk/${name}", to: "runeui/sdk/${name}.js", preload: false`).join("\n") + "\n")

for (const license of ["LICENSE", "LICENSE.md"]) {
  const src = path.join(web, license)
  if (fs.existsSync(src)) fs.copyFileSync(src, path.join(out, "LICENSE"))
}

const bytes = pins.reduce((sum, name) => sum + fs.statSync(path.join(out, `${name}.js`)).size, 0)
console.log(`${names.length} components, ${pins.length} modules, ${(bytes / 1024).toFixed(0)} KB minified`)
fs.rmSync(work, { recursive: true, force: true })
