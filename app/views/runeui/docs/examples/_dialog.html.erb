<%# locals: () %>
<%= ui :dialog, id: "edit-profile", trigger: "Edit profile", title: "Edit profile", description: "Make changes to your profile here. Press Save when you're done.",
  footer: ui(:button, content: "Save changes", type: :submit, form: "profile-form") do %>
  <form id="profile-form" action="<%= runeui_echo_path("dialog") %>" method="post" data-turbo-stream>
    <%= ui :field, label: "Name" do %><%= ui :input, name: "name", value: "Pedro Duarte" %><% end %>
  </form>
<% end %>
<div class="runeui-docs__row">
  <%= ui :button, variant: :secondary, content: "Open it from elsewhere", data: { runeui_open: "edit-profile" } %>
</div>
