<%# locals: () %>
<div class="runeui-docs__row">
  <%= ui :card, size: :sm do %><%= ui :calendar, id: "cal-single", value: Date.new(2026, 10, 16) %><% end %>
  <%= ui :card, size: :sm do %><%= ui :calendar, id: "cal-multiple", mode: :multiple, value: [ Date.new(2026, 10, 6), Date.new(2026, 10, 9) ], min: Date.new(2026, 10, 3) %><% end %>
