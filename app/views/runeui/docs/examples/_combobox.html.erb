<%# locals: () %>
<% frameworks = [ [ "Next.js", "next" ], [ "SvelteKit", "sveltekit" ], [ "Nuxt", "nuxt" ], [ "Remix", "remix" ], [ "Astro", "astro" ] ] %>
<form class="runeui-docs__row" action="<%= runeui_echo_path("combobox") %>" method="post" data-turbo-stream>
  <%= ui :combobox, name: "framework", id: "framework", options: frameworks, placeholder: "Select a framework", clearable: true %>
  <%= ui :combobox, name: "timezone", id: "timezone", value: "cst", options: { "North America" => [ [ "Eastern", "est" ], [ "Central", "cst" ], [ "Pacific", "pst" ] ], "Europe" => [ [ "Greenwich", "gmt" ], [ "Central European", "cet" ] ] } %>
  <%= ui :button, variant: :outline, content: "Send", type: :submit %>
</form>
<h2>Several, as chips</h2>
<form class="runeui-docs__row" action="<%= runeui_echo_path("combobox") %>" method="post" data-turbo-stream>
  <%= ui :combobox, name: "frameworks[]", id: "frameworks", multiple: true, value: %w[next astro], options: frameworks, placeholder: "Add a framework" %>
  <%= ui :button, variant: :outline, content: "Send", type: :submit %>
</form>
<h2>Tags: anything typed becomes one</h2>
<form class="runeui-docs__row" action="<%= runeui_echo_path("combobox") %>" method="post" data-turbo-stream>
  <%= ui :combobox, name: "tags[]", id: "tags", multiple: true, creatable: true, value: %w[urgent], options: %w[urgent design backend follow-up], placeholder: "Add a tag", empty: "Press Enter to add it" %>
  <%= ui :button, variant: :outline, content: "Send", type: :submit %>
</form>
<h2>Searching on the server</h2>
<%= ui :combobox, name: "person", id: "person", src: "/people.json", placeholder: "Search people" %>
<%= ui :combobox, name: "picked_person", id: "person-picker", trigger: true, src: "/people.json?picker=1", value: "4", options: { "People" => [ [ "Katherine Johnson", "4" ] ] }, placeholder: "Choose a person", search: "Find a person…" %>
<h2>Behind a button</h2>
<form class="runeui-docs__row" action="<%= runeui_echo_path("combobox") %>" method="post" data-turbo-stream>
  <%= ui :combobox, name: "owner", id: "owner", trigger: true, options: [ [ "Ada Lovelace", "ada" ], [ "Grace Hopper", "grace" ], [ "Katherine Johnson", "katherine" ] ], placeholder: "Unassigned", search: "Find a person…" %>
  <%= ui :combobox, name: "reviewers[]", id: "reviewers", trigger: true, multiple: true, value: %w[grace], options: [ [ "Ada Lovelace", "ada" ], [ "Grace Hopper", "grace" ], [ "Katherine Johnson", "katherine" ] ], placeholder: "Nobody" %>
  <%= ui :button, variant: :outline, content: "Send", type: :submit %>
</form>
<h2>Opened from elsewhere</h2>
<div class="runeui-docs__row">
  <button type="button" class="ui-button" data-variant="outline" data-size="sm" id="assign-a" data-runeui-open="assignees">Assign task A</button>
  <button type="button" class="ui-button" data-variant="outline" data-size="sm" id="assign-b" data-runeui-open="assignees">Assign task B</button>
  <%= ui :combobox, id: "assignees", multiple: true, trigger: false, options: [ [ "Ada Lovelace", "ada" ], [ "Grace Hopper", "grace" ], [ "Katherine Johnson", "katherine" ] ], search: "Who’s on it…" %>
</div>
