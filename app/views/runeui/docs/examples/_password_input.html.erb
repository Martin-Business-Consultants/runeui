<%# locals: () %>
<form class="runeui-docs__stack runeui-docs__w-60" action="<%= runeui_echo_path("password_input") %>" method="post" data-turbo-stream>
  <%= ui :field, label: "Password" do %>
    <%= ui :password_input, name: "password", id: "password", placeholder: "Your password" %>
  <% end %>
  <%= ui :password_input, name: "bad", value: "short", invalid: true, aria: { label: "Invalid" } %>
  <div class="runeui-docs__row"><%= ui :button, variant: :outline, content: "Sign in", type: :submit %></div>
</form>
