<%# locals: () %>
<form class="runeui-docs__stack" action="<%= runeui_echo_path("rating") %>" method="post" data-turbo-stream>
  <%= ui :rating, name: "score", id: "score", value: 3, aria: { label: "Rating" } %>
  <%= ui :rating, name: "half", step: 0.5, value: 2.5, size: :lg, aria: { label: "Half stars" } %>
  <%= ui :rating, value: 4.2, read_only: true, size: :sm, aria: { label: "Average rating" } %>
  <div class="runeui-docs__row"><%= ui :button, variant: :outline, content: "Send", type: :submit %></div>
</form>
