<%# locals: (items: nil, trigger: nil, content: nil, context: nil, label: nil, side: nil, align: nil, id: nil, bar: nil, part: nil, **attrs) %>
<%#
  Menu: shadcn's Dropdown Menu (and, with context: true, its Context Menu). The trigger opens a
  list of actions; arrows, typeahead and Escape work; submenus open toward their arrow.

  items: is the menu as data, each one of:
    { label: "Profile", href: profile_path, icon: :user, shortcut: "mod+p" }     a link
    { label: "Sign out", href: session_path, method: :delete, confirm: "Sign out?" }
    { label: "Delete", value: "delete", variant: :destructive, disabled: true }  an action:
        the menu fires action (event.detail.value) for Stimulus: data-action="action->x#run"
    :separator
    { heading: "My account" }
    { group: "Team", items: [...] }
    { label: "More", items: [...] }                                       a submenu
    { label: "Status bar", checkbox: true, checked: true, value: "status" }
    { radio: "position", value: "bottom", options: [["Top", "top"], ["Bottom", "bottom"]] }

    ui :menu, trigger: "Open", items: [{ label: "Profile", href: "/me" }, :separator, { label: "Log out", href: "/logout", method: :delete }]
    ui :menu, context: true, items: [...] do
      tag.div("Right-click here", class: "my-area")
    end

  trigger: a string makes an outline button; markup is used as it is.
%>
<% render_items = lambda do |list|
     safe_join(Array(list).map do |item|
       item = { label: item.to_s } if item.is_a?(String) && item != "-"
       if item == :separator || item == "-"
         ui_tag(:ui_menu_separator, { data: { slot: "menu-separator" } })
       elsif item[:heading]
         ui_tag(:ui_menu_group_label, { data: { slot: "menu-group-label" } }, {}, item[:heading])
       elsif item[:group]
         ui_tag(:ui_menu_group, { data: { slot: "menu-group" } }, {}, safe_join([ ui_tag(:ui_menu_group_label, { data: { slot: "menu-group-label" } }, {}, item[:group]), render_items.call(item[:items]) ]))
       elsif item[:radio]
         radios = ui_options(item[:options] || []).map do |option|
           ui_tag(:ui_menu_radio_item, { value: option[:value], disabled: (option[:disabled] ? "" : nil), class: "ui-item", data: { slot: "menu-radio-item" } }, {}, safe_join([ ui_tag(:ui_menu_item_indicator, { data: { slot: "menu-item-indicator" } }, {}, ui_icon(:dot)), option[:label] ]))
         end
         ui_tag(:ui_menu_radio_group, { name: item[:radio], "default-value": item[:value]&.to_s, data: { slot: "menu-radio-group" } }, {}, safe_join(radios))
       elsif item[:checkbox]
         ui_tag(:ui_menu_checkbox_item, { value: (item[:value] || item[:label]).to_s, "default-checked": (item[:checked] ? "" : nil), disabled: (item[:disabled] ? "" : nil), class: "ui-item", data: { slot: "menu-checkbox-item" } }, {}, safe_join([ ui_tag(:ui_menu_item_indicator, { "keep-mounted": "", data: { slot: "menu-item-indicator" } }, {}, ui_icon(:check)), item[:label] ]))
       elsif item[:items]
         ui_tag(:ui_menu_sub, { data: { slot: "menu-sub" } }, {}, safe_join([
           ui_tag(:ui_menu_sub_trigger, { class: "ui-item", data: { slot: "menu-trigger" } }, {}, safe_join([ (item[:icon] ? ui_tag(:ui_menu_item_icon, { data: { slot: "menu-item-icon" } }, {}, ui_icon(item[:icon])) : nil), item[:label], ui_icon("chevron-right", class: "ui-menu-sub-arrow") ].compact)),
           ui_tag(:ui_menu_sub_content, { class: "ui-popup", hidden: true, data: { slot: "menu-content" } }, {}, render_items.call(item[:items]))
         ]))
       else
         inner = safe_join([ (item[:icon] ? ui_tag(:ui_menu_item_icon, { data: { slot: "menu-item-icon" } }, {}, ui_icon(item[:icon])) : nil), item[:label] ].compact)
         common = { disabled: (item[:disabled] ? "" : nil), shortcut: item[:shortcut], class: "ui-item", data: { slot: "menu-item", variant: item[:variant]&.to_s } }
         if item[:href]
           link_data = (item[:data] || {}).merge(turbo_method: item[:method]&.to_s, turbo_confirm: item[:confirm]).compact
           ui_tag(:ui_menu_item, { "as-child": "" }, common.merge(data: { slot: "menu-link-item", variant: item[:variant]&.to_s }), link_to(inner, item[:href], data: link_data, target: item[:target]))
         else
           ui_tag(:ui_menu_item, { value: (item[:value] || item[:label]).to_s }, ui_attrs(common, item[:data] ? { data: item[:data] } : {}), inner)
         end
       end
     end)
   end %>
<% if part.to_s == "items" %>
<%= render_items.call(items) %>
<% else %>
<% list = capture do %><% if content && !context %><%= content %><% end %><%= render_items.call(items) %><% end %>
<%= ui_tag(:ui_menu, { id: id, data: { slot: "menu" } }, attrs) do %>
  <% if context %>
  <ui-menu-context-trigger data-slot="menu-context-trigger" tabindex="0"><%= content %></ui-menu-context-trigger>
  <% elsif trigger %>
  <ui-menu-trigger>
    <% if trigger.html_safe? %>
    <%= trigger %>
    <% elsif bar %>
    <button type="button" data-slot="menu-trigger" class="ui-menubar-trigger"><%= trigger %></button>
    <% else %>
    <button type="button" class="ui-button" data-variant="outline" data-size="default"><%= trigger %></button>
    <% end %>
  </ui-menu-trigger>
  <% end %>
  <%= ui_tag(:ui_menu_content, { class: "ui-popup", side: side&.to_s, align: (align || (bar ? "start" : nil))&.to_s, "aria-label": label, hidden: true, data: { slot: "menu-content" } }, {}, list) %>
<% end %>
<% end %>
