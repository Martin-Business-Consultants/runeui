<%# locals: (content: nil, keys: nil, **attrs) %>
<%#
  Kbd: a key, or keys pressed together (keys: %w[⌘ K]).

    ui :kbd, content: "Esc"
    ui :kbd, keys: %w[⌘ K]
%>
<% if keys %>
<%= ui_tag(:span, { data: { slot: "kbd-group" } }, attrs) do %>
  <% Array(keys).each do |key| %>
  <%# herb:key key %>
  <kbd data-slot="kbd"><%= key %></kbd>
  <% end %>
<% end %>
<% else %>
<%= ui_tag(:kbd, { data: { slot: "kbd" } }, attrs, content) %>
<% end %>
