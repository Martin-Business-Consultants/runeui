<%# locals: (name: nil, value: nil, id: nil, min: nil, max: nil, granularity: nil, hour_cycle: nil, disabled: nil, required: nil, read_only: nil, invalid: nil, form: nil, size: nil, locale: nil, **attrs) %>
<%#
  Date input: a date typed into month, day and year segments (in the locale's order), each
  stepped with the arrow keys. No popup: for a calendar too, use date_picker. Submits YYYY-MM-DD
  under name:, like date_field; with granularity: :minute (or :hour, :second) a date and time,
  "2026-11-02T14:30", like datetime_field. value: a Date, a Time or an ISO string.

    form.ui :date_input, :born_on
    ui :date_input, name: "starts_at", value: Time.current, granularity: :minute
%>
<% timed = granularity.present? && granularity.to_s != "day" %>
<% iso = ->(d) do
     next nil if d.blank?
     next d if d.is_a?(String)
     timed && d.respond_to?(:strftime) && !d.is_a?(Date) ? d.strftime(granularity.to_s == "second" ? "%Y-%m-%dT%H:%M:%S" : "%Y-%m-%dT%H:%M") : d.to_date.iso8601
   end %>
<%= ui_tag(:ui_date_input, { id: ui_id("date-input", id, name: name), name: name, "default-value": iso.(value), min: iso.(min), max: iso.(max), granularity: granularity&.to_s, "hour-cycle": hour_cycle, locale: locale, disabled: (disabled ? "" : nil), required: (required ? "" : nil), "read-only": (read_only ? "" : nil), form: form, data: { slot: "date-input", size: size&.to_s, morph: "keep" }, aria: { invalid: (invalid ? "true" : nil) } }, attrs) %>
