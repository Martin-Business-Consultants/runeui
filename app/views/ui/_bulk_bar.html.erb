<%# locals: (content: nil, **attrs) %>
<%#
  What to do with the rows picked in a table: handed to ui :table as bulk:, it shows while any
  are, with how many ("3 projects selected") and a Clear. The block is the actions, usually
  buttons that submit the form around the table elsewhere:

    bar = ui :bulk_bar do
      ui :button, variant: :outline, size: :sm, content: "Close", formaction: bulk_close_projects_path, formmethod: :patch
      ui :button, variant: :destructive, size: :sm, content: "Delete", formaction: bulk_delete_projects_path, data: { turbo_confirm: "Delete them?" }
    end
    ui :table, selectable: true, noun: "project", bulk: bar do … end
%>
<%= ui_tag(:div, { data: { slot: "bulk-bar", runeui__selection_target: "bar" }, role: "toolbar", aria: { label: "Selected rows" }, hidden: true }, attrs) do %>
  <span data-slot="bulk-count" data-runeui--selection-target="count" aria-live="polite"></span>
  <button type="button" class="ui-button" data-variant="ghost" data-size="sm" data-action="runeui--selection#clear">Clear</button>
  <span data-slot="bulk-actions"><%= content %></span>
<% end %>
