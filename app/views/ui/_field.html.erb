<%# locals: (content: nil, label: nil, description: nil, errors: nil, invalid: nil, orientation: nil, control: nil, control_id: nil, **attrs) %>
<%#
  Field: a label, the control (the block), a description and its errors, linked for screen
  readers by <ui-field>. With form.ui :field, :name the errors come from the record.

    form.ui :field, :email, label: "Email", description: "We'll never share it" do
      form.ui :input, :email, type: :email
    end

  A setting: control: puts the label and description together on the left (data-slot
  field-content) and the control at the row's end, as shadcn's horizontal Field with FieldContent
  does for a switch or a select beside what it means. The block, if any, goes under them.
  control_id: the control's id (form.ui :field fills it in), so the label is a native <label for>
  that names the control however the two upgrade.

    form.ui :field, :public, label: "Public", description: "Anyone with the link can see it",
      control: form.ui(:switch, :public)
%>
<% messages = Array(errors).compact_blank %>
<% if control %>
<%= ui_tag(:ui_field, { data: { slot: "field", orientation: (orientation || "horizontal").to_s }, invalid: ((invalid || messages.any?) ? "" : nil) }, attrs) do %>
  <div data-slot="field-content">
    <% if label && control_id %><%= ui_tag(:label, { for: control_id, data: { slot: "field-label" } }, {}, label) %><% elsif label %><ui-field-label data-slot="field-label"><%= label %></ui-field-label><% end %>
    <% if description %><ui-field-description data-slot="field-description"><%= description %></ui-field-description><% end %>
    <% if messages.any? %><ui-field-error data-slot="field-error" match><%= messages.to_sentence %></ui-field-error><% end %>
    <%= content %>
  </div>
  <%= control %>
<% end %>
<% else %>
<%= ui_tag(:ui_field, { data: { slot: "field", orientation: orientation&.to_s }, invalid: ((invalid || messages.any?) ? "" : nil) }, attrs) do %>
  <% if label %><ui-field-label data-slot="field-label"><%= label %></ui-field-label><% end %>
  <%= content %>
  <% if description %><ui-field-description data-slot="field-description"><%= description %></ui-field-description><% end %>
  <% if messages.any? %><ui-field-error data-slot="field-error" match><%= messages.to_sentence %></ui-field-error><% end %>
<% end %>
<% end %>
