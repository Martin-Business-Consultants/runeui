<%# locals: (name: nil, value: nil, id: nil, placeholder: nil, autocomplete: nil, disabled: nil, required: nil, invalid: nil, form: nil, **attrs) %>
<%#
  Password input, with a button that shows and hides what's typed (Enter still submits).
  autocomplete: "new-password" on a sign-up or change form; "current-password" otherwise.

    ui :password_input, name: "password", placeholder: "Password"
    form.ui :password_input, :password, autocomplete: "new-password"
%>
<%= tag.ui_password_input(**ui_attrs({ name: name, "default-value": value, disabled: (disabled ? "" : nil), required: (required ? "" : nil), form: form, data: { slot: "password-input" } }, attrs.except(:aria))) do %>
  <%= tag.input(type: "password", class: "ui-input", id: ui_id("password", id, name: name), placeholder: placeholder, autocomplete: (autocomplete || "current-password"), data: { slot: "password-input-control" }, aria: (attrs[:aria] || {}).merge(invalid: (invalid ? "true" : nil))) %>
  <ui-password-input-toggle><button type="button" class="ui-button" data-slot="password-input-toggle" data-variant="ghost" data-size="icon-xs" aria-label="Show password"><%= ui_icon :eye, data: { when: "hidden" } %><%= ui_icon "eye-off", data: { when: "visible" } %></button></ui-password-input-toggle>
<% end %>
