<%# locals: (panels: nil, orientation: nil, with_handle: nil, save: nil, step: nil, large_step: nil, **attrs) %>
<%#
  Resizable panels: side by side (or stacked, orientation: :vertical) with handles between them
  to drag or move with the arrow keys. panels: hashes with content:, size: (a percent, or "240px"),
  min:, max:, id: (else one is made, the same each render), label: (names the handle after it),
  collapsible: true (dragged past half its minimum, or Enter or a double-click on its handle,
  folds it to collapsed_size:, 0 by default; Enter again restores it). Give the group a height
  with a class. Hovering a handle shows a grip where the pointer meets it (runeui--resizable);
  with_handle: true draws shadcn's grip on each handle instead, always shown. step: and
  large_step: are how far an arrow key and Shift with one move a handle, in percent (1 and 10);
  Home and End go as far as it goes. save: a key to remember the layout under, per browser (give
  panels ids so it survives changes).

    ui :resizable, class: "h-96", save: "inbox", panels: [
      { id: "folders", size: 20, min: 15, content: render("folders"), label: "Resize folders" },
      { id: "messages", content: render("messages") }
    ]
%>
<% direction = (orientation || "horizontal").to_s %>
<% list = Array(panels) %>
<%= ui_tag(:ui_resizable, { orientation: (orientation ? direction : nil), "auto-save-id": save, step: step, "large-step": large_step, data: { slot: "resizable", orientation: direction, controller: (with_handle ? nil : "runeui--resizable") } }, attrs) do %>
  <% list.each_with_index do |panel, index| %>
  <%# herb:key panel[:id] || index %>
  <%= ui_tag(:ui_resizable_panel, { id: (panel[:id] || ui_id("panel")), "default-size": panel[:size], "min-size": panel[:min], "max-size": panel[:max], collapsible: (panel[:collapsible] ? "" : nil), "collapsed-size": panel[:collapsed_size], data: { slot: "resizable-panel", orientation: direction } }, {}, panel[:content]) %>
  <% if index < list.size - 1 %>
  <ui-resizable-handle data-slot="resizable-handle" data-orientation="<%= direction %>" aria-label="<%= panel[:label] || "Resize" %>"><% if with_handle %><span data-slot="resizable-grip"><%= ui_icon "grip-vertical" %></span><% else %><span data-slot="resizable-pill"></span><% end %></ui-resizable-handle>
  <% end %>
  <% end %>
<% end %>
