<%# locals: (orientation: nil, decorative: nil, **attrs) %>
<%#
  Separator: a line between groups of content, across (horizontal) or, in a row, up and down
  (vertical). decorative: true hides it from screen readers when it only looks like a break.

    ui :separator
    ui :separator, orientation: :vertical, decorative: true
%>
<%= ui_tag(:ui_separator, { orientation: (orientation || "horizontal").to_s, decorative: (decorative ? "" : nil), data: { slot: "separator", orientation: (orientation || "horizontal").to_s } }, attrs) %>
