<%# locals: (spans: nil, label: nil, expanded: nil, columns: nil, axis: nil, **attrs) %>
<%#
  Waterfall: spans of time on a shared axis, like a trace or network requests, nested spans
  folding under their parent; arrow keys move through rows, Right and Left open and fold.
  spans: hashes with value:, label:, start: and duration: (ms), children: (more spans), and
  any column values. columns: [[key, heading], …] for cells before the bar. label: names it.
  expanded: values open at first (default: every span with children).

    ui :waterfall, label: "Checkout trace", columns: [ [ :status, "Status" ] ], spans: [
      { value: "checkout", label: "POST /checkout", start: 0, duration: 820, status: 200, children: [
        { value: "db", label: "SELECT carts", start: 40, duration: 120, status: "ok" } ] }
    ]
%>
<% flatten = ->(list, level) { Array(list).flat_map { |s| [ [ s, level ] ] + flatten.(s[:children], level + 1) } } %>
<% rows = flatten.(spans, 1) %>
<% open = expanded ? Array(expanded).map(&:to_s) : rows.select { |s, _| Array(s[:children]).any? }.map { |s, _| s[:value].to_s } %>
<% data = ->(list) { Array(list).map { |s| { value: s[:value].to_s, label: s[:label].to_s, start: s[:start], duration: s[:duration], children: (s[:children] ? data.(s[:children]) : nil) }.compact } } %>
<%= ui_tag(:ui_waterfall, { "default-expanded": (open.any? ? open.join(",") : nil), aria: { label: label }, data: { slot: "waterfall", props: { items: data.(spans) }.to_json } }, attrs) do %>
  <% if axis != false %>
  <ui-waterfall-header-row data-slot="waterfall-header-row">
    <ui-waterfall-column-header data-slot="waterfall-column-header">Name</ui-waterfall-column-header>
    <% Array(columns).each do |key, heading| %>
    <%# herb:key key %>
    <ui-waterfall-column-header data-slot="waterfall-column-header"><%= heading %></ui-waterfall-column-header>
    <% end %>
    <ui-waterfall-column-header data-slot="waterfall-column-header" aria-label="Timeline"><ui-waterfall-axis data-slot="waterfall-axis"></ui-waterfall-axis></ui-waterfall-column-header>
  </ui-waterfall-header-row>
  <% end %>
  <% rows.each do |span, level| %>
  <%# herb:key span[:value] %>
  <ui-waterfall-row value="<%= span[:value] %>" data-slot="waterfall-row" data-level="<%= level %>"<% if Array(span[:children]).any? %> data-branch<% end %>>
    <ui-waterfall-row-header data-slot="waterfall-row-header" data-level="<%= level %>"><% if Array(span[:children]).any? %><ui-waterfall-indicator data-slot="waterfall-indicator"><%= ui_icon "chevron-right" %></ui-waterfall-indicator><% end %><span data-slot="waterfall-name"><%= span[:label] %></span></ui-waterfall-row-header>
    <% Array(columns).each do |key, _| %>
    <%# herb:key key %>
    <ui-waterfall-cell data-slot="waterfall-cell"><%= span[key] %></ui-waterfall-cell>
    <% end %>
    <ui-waterfall-bar data-slot="waterfall-bar"></ui-waterfall-bar>
  </ui-waterfall-row>
  <% end %>
<% end %>
